# Local dependencies and machine configuration
node_modules/
.venv/
__pycache__/
*.pyc
.env
.env.*
.agent-secrets/
*.key
*.pem
.local/

# Production history, checks, and rendered outputs
archive/
qa/
deliverables/
renders/
*.mp4
*.mkv
*.mov
*.webm
*.render.json
*.log

# Music, lyrics, fonts, and mixed source packages retain separate rights
assets/audio/*
!assets/audio/README.md
assets/subtitles/*
!assets/subtitles/README.md
assets/source-packs/
assets/fonts/*
!assets/fonts/README.md
assets/third-party-derived/
*.mp3
*.wav
*.m4a
*.flac
*.f32
*.srt
*.ttf
*.ttc
*.otf
*.woff
*.woff2

# Binary art is opt-in through the file-level asset license inventory.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.avif
*.svg

# Local publication forms and production handoff records
production/**/final-release-metadata.json
production/**/final-release-description.txt
production/**/release-task-route.md

